<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="vla_tabletop_world">
    <!-- Sunlight -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <!-- Tabletop surface -->
    <model name="work_table">
      <static>true</static>
      <pose>0.4 0.0 0.4 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.2 0.8 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.2 0.8 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
          </material>
        </visual>
      </link>
    </model>
    <!-- Target Red Bottle -->
    <model name="red_bottle">
      <pose>0.32 0.18 0.85 0 0 0</pose>
      <link name="bottle_link">
        <collision name="bottle_collision">
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.18</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="bottle_visual">
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.18</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
