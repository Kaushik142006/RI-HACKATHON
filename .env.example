# Environment configuration for Vision-Language-Action Intelligent Robot
APP_ENV=development
SIMULATION_MODE=true
LOG_LEVEL=INFO

# Robot Configuration
ROBOT_NAME=vla_manipulator_6dof
ROBOT_BASE_FRAME=base_link
ROBOT_EE_FRAME=tool0_flange
GRIPPER_MAX_EFFORT=100.0
GRIPPER_OPEN_WIDTH=0.08
WORKSPACE_X_MIN=-0.8
WORKSPACE_X_MAX=0.8
WORKSPACE_Y_MIN=-0.8
WORKSPACE_Y_MAX=0.8
WORKSPACE_Z_MIN=0.0
WORKSPACE_Z_MAX=1.2
MAX_JOINT_VELOCITY=1.5
MAX_ACCELERATION=1.0

# Camera & Vision Configuration
CAMERA_TYPE=realsense_d435i
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
ENABLE_DEPTH=true
YOLO_MODEL_PATH=yolov8n.pt
YOLO_SEG_MODEL_PATH=yolov8n-seg.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# NLP & LLM Configuration
WHISPER_MODEL_SIZE=base
SPACY_MODEL=en_core_web_sm
OPENAI_API_KEY=mock-key-if-not-set
LLM_PROVIDER=mock_or_openai
LLM_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vla_robot_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=5.0

# ROS 2 & Middleware Configuration
ROS_DOMAIN_ID=0
ROS_NAMESPACE=/vla_robot
ENABLE_ROS2=false

# Web Interface
WEB_HOST=0.0.0.0
WEB_PORT=8000
